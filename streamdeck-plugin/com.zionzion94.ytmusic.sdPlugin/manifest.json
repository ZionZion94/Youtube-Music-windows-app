{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "com.zionzion94.ytmusic",
	"Name": "YouTube Music",
	"Version": "1.4.0.0",
	"Author": "ZionZion94",
	"Description": "Contrôle l'application de bureau YouTube Music : lecture/pause, titre suivant et précédent, volume, J'aime / Je n'aime pas, titre en cours avec pochette.",
	"Category": "YouTube Music",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"Actions": [
		{
			"Name": "Titre en cours",
			"UUID": "com.zionzion94.ytmusic.nowplaying",
			"Icon": "imgs/actions/nowplaying/icon",
			"Tooltip": "Affiche la pochette, le titre et l'artiste en cours. Appuyer pour lecture / pause.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/nowplaying/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Lecture / Pause",
			"UUID": "com.zionzion94.ytmusic.playpause",
			"Icon": "imgs/actions/playpause/icon",
			"Tooltip": "Met en lecture ou en pause. L'icône suit l'état du lecteur.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/playpause/play",
					"ShowTitle": false
				},
				{
					"Image": "imgs/actions/playpause/pause",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Titre précédent",
			"UUID": "com.zionzion94.ytmusic.previous",
			"Icon": "imgs/actions/previous/icon",
			"Tooltip": "Revient au titre précédent.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/previous/prev",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Titre suivant",
			"UUID": "com.zionzion94.ytmusic.next",
			"Icon": "imgs/actions/next/icon",
			"Tooltip": "Passe au titre suivant.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/next/next",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Volume −",
			"UUID": "com.zionzion94.ytmusic.volumedown",
			"Icon": "imgs/actions/volumedown/icon",
			"Tooltip": "Baisse le volume de 5 % et l'affiche sur la touche.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/volumedown/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Volume +",
			"UUID": "com.zionzion94.ytmusic.volumeup",
			"Icon": "imgs/actions/volumeup/icon",
			"Tooltip": "Monte le volume de 5 % et l'affiche sur la touche.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/volumeup/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "J'aime",
			"UUID": "com.zionzion94.ytmusic.like",
			"Icon": "imgs/actions/like/icon",
			"Tooltip": "Ajoute le titre en cours aux titres aimés (réappuyer pour annuler). La touche s'allume si le titre est aimé.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/like/off",
					"ShowTitle": false
				},
				{
					"Image": "imgs/actions/like/on",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Je n'aime pas",
			"UUID": "com.zionzion94.ytmusic.dislike",
			"Icon": "imgs/actions/dislike/icon",
			"Tooltip": "Marque le titre en cours « Je n'aime pas » (réappuyer pour annuler). La touche s'allume si c'est le cas.",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/dislike/off",
					"ShowTitle": false
				},
				{
					"Image": "imgs/actions/dislike/on",
					"ShowTitle": false
				}
			]
		}
	]
}